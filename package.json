{
    "name": "blog-api",
    "version": "1.0.0",
    "description": "A RESTful API to build a blogging app",
    "main": "server.js",
    "scripts": {
        "start": "NODE_ENV=production node server.js",
        "dev": "NODE_ENV=development nodemon server.js",
        "test": "jest --runInBand --detectOpenHandles --forceExit"
    },
    "jest": {
        "testEnvironment": "node",
        "coveragePathIgnorePatterns": [
            "/node_modules/"
        ]
    },
    "keywords": [
        "blog",
        "api"
    ],
    "author": "Muhammad Sajid => (@sajidcodess) in github",
    "license": "ISC",
    "dependencies": {
        "bcrypt": "^5.1.1",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.5.2",
        "nodemailer": "^6.9.14",
        "nodemon": "^3.1.4",
        "validator": "^13.12.0"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "supertest": "^7.0.0"
    }
}
